/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://cloud.umami.is https://giscus.app; style-src 'self' 'unsafe-inline' https://giscus.app; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://cloud.umami.is https://giscus.app; frame-src https://www.youtube-nocookie.com https://giscus.app https://thesymbioticmind.substack.com https://buttondown.com; form-action 'self' https://buttondown.com https://thesymbioticmind.substack.com

/feed.xml
  Content-Type: application/rss+xml; charset=utf-8

/feed.json
  Content-Type: application/feed+json; charset=utf-8

/feed/*
  Content-Type: application/rss+xml; charset=utf-8

/podcast.xml
  Content-Type: application/rss+xml; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

/css/*
  Cache-Control: public, max-age=31536000, immutable

# giscus fetches this from ITS origin, so it needs CORS or the theme silently
# falls back to GitHub's default light — a failure that looks like "it didn't
# apply", never like an error. This block sits AFTER /css/* on purpose: it also
# overrides the 1-year immutable above, so the theme can be iterated on without
# waiting out a year of cache.
/css/giscus-theme.css
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/images/*
  Cache-Control: public, max-age=31536000, immutable
